# ── LLM (free by default) ──────────────────────────────────────────────────
# Flint's whole pipeline runs on a free provider out of the box. The default is
# Groq: no credit card, OpenAI-compatible, real-time (300-800 tok/s). Get a key
# at https://console.groq.com and paste it below.
LLM_PROVIDER=groq            # groq | gemini | openai | claude | ollama
GROQ_API_KEY=                # https://console.groq.com  (free, no credit card)
GEMINI_API_KEY=              # https://aistudio.google.com/apikey  (free tier)
ANTHROPIC_API_KEY=           # optional (paid)
OPENAI_API_KEY=skip          # optional (paid)
# Optional model overrides (blank = the provider's sensible default).
LLM_MODEL=                   # e.g. llama-3.3-70b-versatile / gemini-2.5-flash
LLM_FAST_MODEL=              # cheap/fast tier for quick tasks (e.g. llama-3.1-8b-instant)

# Database
DATABASE_URL=postgresql://postgres:flint@localhost:5432/flint

# Redis
REDIS_URL=redis://localhost:6379

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# App
FLINT_API_KEY=  # Optional; blank = no API key auth. Set to require X-API-Key or Authorization: Bearer

# Security: block http/webhook tasks from reaching private/internal/metadata
# addresses (SSRF guard). Set true ONLY when self-hosting and calling internal
# services you control.
ALLOW_PRIVATE_URLS=false

# OAuth (Google, GitHub). Set to enable Sign in with Google/GitHub.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
AUTH_REDIRECT_BASE_URL=  # Frontend URL after login, e.g. https://flint-dashboard.vercel.app
FLINT_ENV=development  # development | production
FLINT_PORT=8000
FLINT_LOG_LEVEL=INFO
FLINT_SECRET_KEY=change-this-in-production

# Distributed tracing (optional; install [observability] extra)
OTEL_ENABLED=false
OTEL_SERVICE_NAME=flint
OTEL_EXPORTER_OTLP_ENDPOINT=  # e.g. http://localhost:4318
